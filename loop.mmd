  reviewer -->|"correctness verdict"| verifier
  verifier --> done

  verifier -.->|"spec hole"| specAuthor
  verifier -.->|"missing test or meaningful mutant"| testAuthor
  verifier -.->|"bug or hotspot extract"| coder
  reviewer -.->|"needs changes"| coder

flowchart TD
  task{{"0 Given task"}}

  subgraph writes["may write"]
    specAuthor["1 spec-author<br/>Gherkin / EARS + mermaid<br/><i>writes: specs</i>"]
    testAuthor["2 test-author<br/>RED component + unit tests<br/><i>writes: tests, interfaces, stubs</i>"]
    coder["3 coder<br/>GREEN + typecheck + lint<br/><i>writes: production code</i>"]
  end

  subgraph readonly["read-only — cannot fix what it finds"]
    reviewer["4 reviewer<br/>spec conformance + regression-dog"]
